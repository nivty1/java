class Tester {
    public static int search() {
        int index = -1;
        String empName = "Joy";
        String[] empNameArr = {
            "James", "Andrew", "Rose", "Joy", "Donald", "Jack"
        };

        for (int i = 0; i < empNameArr.length; i++) {
            if (empNameArr[i].equals(empName)) {
                index = i;
                break;
            }
        }

        return index;
    }

    public static void main(String[] args) {
        int index = search();
        System.out.println(index);
    }
}
