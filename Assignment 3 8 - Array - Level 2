class Tester {

    public static String[] findPermutations(String str) {

        String[] permutations = new String[6];
        int index = 0;

        for (int i = 0; i < 3; i++) {
            for (int j = 0; j < 3; j++) {
                for (int k = 0; k < 3; k++) {

                    if (i != j && j != k && i != k) {

                        String permutation = ""
                                + str.charAt(i)
                                + str.charAt(j)
                                + str.charAt(k);

                        boolean duplicate = false;

                        for (int x = 0; x < index; x++) {
                            if (permutations[x].equals(permutation)) {
                                duplicate = true;
                                break;
                            }
                        }

                        if (!duplicate) {
                            permutations[index++] = permutation;
                        }
                    }
                }
            }
        }

        return permutations;
    }

    public static void main(String args[]) {

        String str = "abc";

        String permutations[] = findPermutations(str);

        for (String permutation : permutations) {
            if (permutation != null) {
                System.out.println(permutation);
            }
        }
    }
}
